<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog</title>
</head>
<body>
    <%- include('./partials/nav') %>
    <div class="container mt-4">
       <h1><%= blog.title %></h1>
       <img src="<%= blog.coverImageURL %>" width="500px">
       <p><%= blog.body %></p>
    </div>

    <div class="container mt-4">
        <img src="<%= blog.author.profileImageURL %>" width="50px" class="rounded-circle"><%= blog.author.fullName %>
    </div>

       <div class="container mt-4">
        <h2>Comments (<%= comments.length %>)</h2>

        <% if (locals.user) { %>
            <form action="/blog/comment/<%= blog._id %>" method="POST">
                <div class="mb-3">
                    <input type="text" class="form-control" id="content" name="content" placeholder="Enter your comment" required>
                    <button type="submit" class="btn btn-primary mt-2">Add</button>
                </div>
            </form>
        <% } %>

        <% comments.forEach(comment => { %>
            <div class="card mb-2" style="max-width: 700px;">
                <div class="card-body">
                    <img src="<%= comment.author.profileImageURL %>" width="30px" class="rounded-circle">
                    <%= comment.author.fullName %>
                    <pre class="mt-2 mb-0"><%= comment.content %></pre>
                </div>
            </div>
        <% }) %>
    </div>
    <%- include('./partials/script') %>
</body>
</html>