<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog</title>
</head>
<body>
    <%- include('./partials/nav') %>
    <div class="container mt-4">
       <h1><%= blog.title %></h1>
       <img src="<%= blog.coverImageURL %>" width="500px">
       <p><%= blog.body %></p>
    </div>

    <div class="container mt-4">
        <img src="<%= blog.author.profileImageURL %>" width="50px" class="rounded-circle"><%= blog.author.fullName %>
    </div>

    <%- include('./partials/script') %>
</body>
</html>